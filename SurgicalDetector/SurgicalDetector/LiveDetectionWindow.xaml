<Window x:Class="SurgicalDetector.LiveDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SurgicalDetector"
        mc:Ignorable="d"
        Title="Live Camera Detection" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button" x:Key="SurgicalButtonStyle">
            <Setter Property="Background" Value="#556B2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="Select Camera:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CameraComboBox" Width="200" VerticalContentAlignment="Center"/>
            <Button x:Name="StartButton" Content="Start Camera" Style="{StaticResource SurgicalButtonStyle}" Click="StartButton_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="10" BorderBrush="#556B2F" BorderThickness="2" CornerRadius="5">
            <Image x:Name="LiveImage" Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>