<UserControl x:Class="SurgicalDetector.Views.LiveDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:LiveDetectionViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Path Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z" 
                      Fill="{StaticResource BrushAccent}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock Text="Live Stream Analysis" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Real-time object detection using connected camera devices." Foreground="{StaticResource BrushTextSecondary}" FontSize="16" Margin="40,5,0,0"/>
        </StackPanel>

        <!-- Main Area -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Width="250" Height="40" 
                              ItemsSource="{Binding AvailableCameras}"
                              SelectedIndex="{Binding SelectedCameraIndex}"
                              IsEnabled="{Binding IsCameraSelectionEnabled}"
                              VerticalContentAlignment="Center"
                              Margin="0,0,10,0"/>

                    <Button Grid.Column="1" 
                            Content="{Binding StartButtonContent}"
                            Command="{Binding ToggleCameraCommand}"
                            Style="{StaticResource SurgicalButtonStyle}"
                            Width="150"/>

                    <!-- Status Indicator (FIXED: Uses Triggers instead of missing Converter) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF757575"/>
                                    <!-- Default Gray -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                            <Setter Property="Fill" Value="#FF4CAF50"/>
                                            <!-- Active Green -->
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <BlurEffect Radius="4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding IsCameraRunning, StringFormat='Status: {0}'}" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- Video Feed -->
                <Border Grid.Row="1" Background="Black" CornerRadius="5" ClipToBounds="True">
                    <Grid>
                        <!-- Feed -->
                        <Image Source="{Binding LiveImageSource}" Stretch="Uniform"/>

                        <!-- Overlay for stopped state (FIXED: Uses registered Converter) -->
                        <Grid Background="#CC000000" Visibility="{Binding IsCameraRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M9,9V15L15,12L9,9Z" 
                                      Fill="{StaticResource BrushSurfaceLight}" Width="64" Height="64" Stretch="Uniform"/>
                                <TextBlock Text="Camera Feed Paused" Foreground="{StaticResource BrushTextSecondary}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>