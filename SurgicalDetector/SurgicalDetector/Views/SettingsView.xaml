<UserControl x:Class="SurgicalDetector.Views.SettingsView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}"
d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.5,21.9 9.3,21.7L4.3,16.7C4.1,16.5 4,16.25 4,16V8C4,7.75 4.1,7.5 4.3,7.3L9.3,2.3C9.5,2.1 9.75,2 10,2H14C14.25,2 14.5,2.1 14.7,2.3L19.7,7.3C19.9,7.5 20,7.75 20,8V16C20,16.25 19.9,16.5 19.7,16.7L14.7,21.7C14.5,21.9 14.25,22 14,22H10Z" 
              Fill="{StaticResource BrushSurfaceLight}" 
              Width="80" Height="80" Stretch="Uniform" 
              HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Configuration options will appear here." Foreground="{StaticResource BrushTextSecondary}" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>

            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20" Margin="0,40,0,0" Width="400">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,10"/>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Dark Mode" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="True"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>