<UserControl x:Class="SurgicalDetector.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}"
             d:DesignHeight="750" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center">
            
            <!-- HEADER -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <Border Background="{StaticResource BrushSurfaceLight}" Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0">
                    <Path Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.5,21.9 9.3,21.7L4.3,16.7C4.1,16.5 4,16.25 4,16V8C4,7.75 4.1,7.5 4.3,7.3L9.3,2.3C9.5,2.1 9.75,2 10,2H14C14.25,2 14.5,2.1 14.7,2.3L19.7,7.3C19.9,7.5 20,7.75 20,8V16C20,16.25 19.9,16.5 19.7,16.7L14.7,21.7C14.5,21.9 14.25,22 14,22H10Z" 
                          Fill="{StaticResource BrushAccentHighlight}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="System Configuration" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Configure intelligence models, computer vision thresholds, and runtime settings." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- STATUS MESSAGE BANNER -->
            <Border Background="{StaticResource BrushSurfaceLight}" 
                    BorderBrush="{StaticResource BrushAccentHighlight}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="14,10" 
                    Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Medium"/>
            </Border>

            <!-- CARD 1: GEMINI AI CREDENTIALS -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Generative AI &amp; Baymax Assistant" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Google Gemini API credentials power clinical instrument explanations and conversational triage." 
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,16"/>
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

                    <TextBlock Text="Gemini API Key" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource BrushSurfaceLight}" 
                             Foreground="{StaticResource BrushTextPrimary}" 
                             BorderBrush="{StaticResource BrushBorder}" 
                             BorderThickness="1" 
                             Padding="10,8" 
                             FontSize="13"/>
                    <TextBlock Text="Security Note: Stored locally in %LOCALAPPDATA%\SurgicalDetector\config.json (or via GEMINI_API_KEY environment variable). Never committed to version control." 
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- CARD 2: INFERENCE SETTINGS -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="YOLOv11 Inference &amp; Vision Engine" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Tune object detection sensitivity, non-maximum suppression, and aspect ratio normalization." 
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,16"/>
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

                    <!-- CONFIDENCE THRESHOLD SLIDER -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Detection Confidence Threshold" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            <TextBlock Text="Minimum confidence score required to propose a surgical instrument bounding box." 
                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,8"/>
                            <Slider Minimum="0.10" Maximum="0.95" Value="{Binding ConfidenceThreshold, Mode=TwoWay}" 
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.1"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceLight}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding ConfidencePercentageText}" Foreground="{StaticResource BrushAccentHighlight}" FontWeight="Bold" FontSize="14"/>
                        </Border>
                    </Grid>

                    <!-- NMS THRESHOLD SLIDER -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NMS IoU Suppression Threshold" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            <TextBlock Text="Intersection-over-Union threshold for merging overlapping bounding boxes of the same class." 
                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,8"/>
                            <Slider Minimum="0.10" Maximum="0.90" Value="{Binding NmsThreshold, Mode=TwoWay}" 
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.1"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceLight}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding NmsPercentageText}" Foreground="{StaticResource BrushAccentHighlight}" FontWeight="Bold" FontSize="14"/>
                        </Border>
                    </Grid>

                    <!-- PREPROCESSING LETTERBOX TOGGLE -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Aspect-Ratio Preserving Letterbox" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            <TextBlock Text="Maintains geometric fidelity by padding to 640x640 (recommended for medical instruments)." 
                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding UseLetterbox}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- CARD 3: ACTIONS -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Save Configuration" Command="{Binding SaveSettingsCommand}" 
                            Style="{StaticResource SurgicalButtonStyle}" Margin="10,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}" 
                            Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" 
                            BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Padding="16,8" Cursor="Hand"/>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>