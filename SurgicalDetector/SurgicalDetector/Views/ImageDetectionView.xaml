<UserControl x:Class="SurgicalDetector.Views.ImageDetectionView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance viewModels:ImageDetectionViewModel}"
d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="BaymaxButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#556B2F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#556B2F"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,15,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Baymax Icon Concept (Simple Circle) -->
                                <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#11556B2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Smart Scan" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Upload and analyze surgical instruments with AI assistance." Foreground="#AAAAAA" FontSize="16" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" 
                    Content="Upload Image" 
                    Command="{Binding SelectImageCommand}"
                    Style="{StaticResource SurgicalButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20"/>

                <Border Grid.Row="1" Background="#252526" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ResultImageSource}" Stretch="Uniform" Margin="10"/>
                        <Border BorderBrush="#333337" BorderThickness="2" CornerRadius="10" Margin="20"
                            Visibility="{Binding ResultImageSource, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5" 
                                  Fill="#333337" Width="64" Height="64" Stretch="Uniform"/>
                                <TextBlock Text="No Image Loaded" Foreground="#333337" FontSize="18" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="#1E1E1E" Margin="20,0,0,0" 
            Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" Direction="180"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20">
                    <TextBlock Text="Analysis Results" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl ItemsSource="{Binding DetectedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252526" CornerRadius="8" Margin="0,0,0,15" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Border HorizontalAlignment="Left" Width="5" Background="{Binding ColorBrush}"/>

                                        <StackPanel Margin="10,0,0,0">
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="6" Height="80" Width="80" 
                                                    ClipToBounds="True" Background="Black"
                                                    BorderBrush="{Binding ColorBrush}" BorderThickness="2">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#556B2F" FontSize="12" Margin="0,2,0,5"/>
                                                    <TextBlock Text="{Binding Confidence, StringFormat=Confidence: {0:P1}}" Foreground="#888" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border BorderBrush="#333" BorderThickness="0,1,0,0" Padding="15">
                                                <StackPanel>
                                                    <TextBlock Text="Database Info:" FontWeight="SemiBold" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding LocalDescription}" TextWrapping="Wrap" Foreground="#DDD" FontSize="13" LineHeight="20"/>

                                                    <!-- Baymax Buttons -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Ask Baymax" 
                                                            Command="{Binding AskBaymaxCommand}"
                                                            CommandParameter="en"
                                                            Style="{StaticResource BaymaxButtonStyle}"/>

                                                        <Button Content="تحلیل بیمکس" 
                                                            Command="{Binding AskBaymaxCommand}"
                                                            CommandParameter="fa"
                                                            Style="{StaticResource BaymaxButtonStyle}"
                                                            FontFamily="Segoe UI"/>
                                                    </StackPanel>

                                                    <Border Background="#151515" CornerRadius="5" Margin="0,15,0,0" Padding="15" 
                                                        Visibility="{Binding IsAiExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAiLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="Baymax is thinking..." Foreground="#556B2F" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding IsAiLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="Baymax Diagnosis" FontWeight="Bold" Foreground="#556B2F" Margin="0,0,0,10"/>
                                                                    <TextBlock Text="{Binding AiAnalysis}" TextWrapping="Wrap" Foreground="#EEE" LineHeight="24"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>