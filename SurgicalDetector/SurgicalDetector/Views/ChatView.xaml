<UserControl x:Class="SurgicalDetector.Views.ChatView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
xmlns:infra="clr-namespace:SurgicalDetector.Infrastructure"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance viewModels:ChatViewModel}"
d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Chat Bubble Selector -->
        <DataTemplate x:Key="UserMessageTemplate">
            <Border Background="#556B2F" CornerRadius="15,15,0,15" Padding="15" Margin="50,5,10,5" HorizontalAlignment="Right" MaxWidth="600">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" Opacity="0.2" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- FIX: Use NotNull converter to show image only when it exists -->
                    <Image Source="{Binding DisplayImage}" MaxHeight="200" Stretch="Uniform" Margin="0,0,0,10" 
                       Visibility="{Binding DisplayImage, Converter={StaticResource NotNullToVisibilityConverter}}"/>

                    <!-- FIX: Use Markdown Behavior for RTL and Bold text -->
                    <TextBlock infra:MarkdownBehavior.MarkdownText="{Binding Content}" 
                           Foreground="White" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>

                    <TextBlock Text="{Binding Timestamp, StringFormat=t}" Foreground="#AACCAA" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BaymaxMessageTemplate">
            <Grid Margin="10,5,50,5" HorizontalAlignment="Left" MaxWidth="600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="35" Height="35" Fill="#E0E0E0" VerticalAlignment="Bottom" Margin="0,0,10,0"/>
                <Path Grid.Column="0" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,7H13V9H11V7M11,11H13V17H11V11Z" 
                  Fill="#333" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Bottom" Margin="7,0,0,8"/>

                <Border Grid.Column="1" Background="#333337" CornerRadius="15,15,15,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Baymax" FontWeight="Bold" Foreground="#556B2F" FontSize="11" Margin="0,0,0,5"/>

                        <!-- FIX: Use Markdown Behavior for RTL and Bold text -->
                        <TextBlock infra:MarkdownBehavior.MarkdownText="{Binding Content}" 
                               Foreground="#F1F1F1" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>

                        <TextBlock Text="{Binding Timestamp, StringFormat=t}" Foreground="#888" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <viewModels:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                        UserTemplate="{StaticResource UserMessageTemplate}"
                                        ModelTemplate="{StaticResource BaymaxMessageTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#202020" BorderBrush="#333" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="+ New Chat" Command="{Binding NewChatCommand}" 
                    Background="#556B2F" Foreground="White" BorderThickness="0" 
                    Height="40" Margin="15" Cursor="Hand" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#2D2D30" Foreground="White" BorderThickness="0" 
                     Padding="10" Margin="15,0,15,15" Tag="Search chats..."/>

                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredSessions}" SelectedItem="{Binding SelectedSession}" 
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Margin="5,2" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- View Mode -->
                                                <StackPanel Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastUpdated, StringFormat='MM/dd HH:mm'}" Foreground="#777" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Edit Mode -->
                                                <Grid Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="#444" Foreground="White" BorderThickness="0"/>
                                                    <Button Grid.Column="1" Content="✓" 
                                                        Command="{Binding DataContext.SaveChatTitleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Green" Foreground="White" Width="20" Height="20" Margin="5,0,0,0"/>
                                                </Grid>

                                                <!-- Action Buttons (Hover) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Hidden" Name="ActionPanel">
                                                    <Button Content="✎" Command="{Binding DataContext.RenameChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" FontSize="14" Margin="0,0,5,0" Cursor="Hand"/>
                                                    <Button Content="×" Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D30"/>
                                                <Setter TargetName="ActionPanel" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#333337"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="20,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedSession.Title, FallbackValue='Baymax Chat'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#556B2F" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Beta" FontSize="10" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Messages List -->
            <ScrollViewer Grid.Row="1" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurrentMessages}" ItemTemplateSelector="{StaticResource MessageTemplateSelector}"/>
            </ScrollViewer>

            <!-- Input Area -->
            <Grid Grid.Row="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image Preview (FIX: Use NotNullToVisibilityConverter) -->
                <Border Grid.Row="0" CornerRadius="10" Background="#252526" HorizontalAlignment="Left" Margin="0,0,0,10" 
                    Visibility="{Binding AttachedImagePreview, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <Grid>
                        <Image Source="{Binding AttachedImagePreview}" Height="80" Margin="10"/>
                        <Button Content="×" Command="{Binding RemoveImageCommand}" 
                            VerticalAlignment="Top" HorizontalAlignment="Right" Background="Red" Foreground="White" 
                            Width="20" Height="20" Margin="0,-5,-5,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Input Box -->
                <Border Grid.Row="1" Background="#2D2D30" CornerRadius="25" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding AttachImageCommand}" Background="Transparent" BorderThickness="0" Margin="10,0,5,0" Cursor="Hand">
                            <Path Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z" 
                              Fill="#AAA" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>

                        <TextBox Grid.Column="1" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" 
                             VerticalContentAlignment="Center" MaxHeight="100" TextWrapping="Wrap" AcceptsReturn="True"
                             Padding="5">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2" Command="{Binding SendCommand}" Background="{StaticResource BrushAccent}" 
                            Width="40" Height="40" Margin="5" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z" Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="2,0,0,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>