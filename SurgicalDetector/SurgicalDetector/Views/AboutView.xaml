<UserControl x:Class="SurgicalDetector.Views.AboutView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance viewModels:AboutViewModel}"
d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Glass Panel Style -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Tech Stack Item Template -->
        <DataTemplate x:Key="TechStackTemplate">
            <Border Background="#202020" CornerRadius="8" Padding="15" Margin="0,0,10,10" Width="100" Height="100" ToolTip="{Binding Description}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="{Binding IconData}" Fill="#777" Height="32" Width="32" Stretch="Uniform" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Name}" Foreground="#DDD" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                </StackPanel>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#556B2F" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#202020" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </DataTemplate>

        <!-- Team Member Template -->
        <DataTemplate x:Key="TeamMemberTemplate">
            <Border Background="#202020" CornerRadius="10" Padding="15" Margin="0,0,15,10" Width="300">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Ellipse Width="50" Height="50" Fill="{Binding ColorHex}"/>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                        <TextBlock Text="{Binding Role}" Foreground="#AAA" FontSize="12"/>
                        <TextBlock Text="{Binding GithubLink}" Foreground="#556B2F" FontSize="10" Margin="0,3,0,0" Cursor="Hand" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Dynamic Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111" Offset="0"/>
                <GradientStop Color="#1a2515" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Abstract Model Architecture Art (Background) -->
        <Path Data="M10,10 L50,50 L90,10 M50,50 L50,150 M10,190 L50,150 L90,190" Stroke="#09FFFFFF" StrokeThickness="2" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="600" Height="600" Margin="0,0,-100,-100" IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header & Heartbeat Logo -->
                <Grid Grid.Row="0" Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="100" Height="100" Background="#556B2F" CornerRadius="30" Margin="0,0,30,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding EasterEggCommand}"/>
                        </Border.InputBindings>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="HeartbeatScale" ScaleX="1" ScaleY="1" CenterX="50" CenterY="50"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="HeartbeatScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:1"/>
                                        <DoubleAnimation Storyboard.TargetName="HeartbeatScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Fill="White" Stretch="Uniform" Margin="25"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="42" FontWeight="Bold" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding Version}" FontSize="18" Foreground="#556B2F" FontWeight="SemiBold"/>
                            <Border Background="#333" CornerRadius="4" Padding="6,2" Margin="15,0,0,0">
                                <TextBlock Text="License: Enterprise" FontSize="12" Foreground="#AAA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding EasterEggMessage}" Foreground="#8BC34A" FontSize="14" Margin="0,10,0,0" FontWeight="Bold">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#8BC34A" BlurRadius="10"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 2. Main Content Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0">

                        <!-- Daily Quote -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <Path Data="M14,17H17L19,13V7H13V13H16M6,17H9L11,13V7H5V13H8L6,17Z" Fill="#556B2F" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding DailyQuote}" FontSize="18" FontStyle="Italic" FontFamily="Georgia" Foreground="#EEE" TextWrapping="Wrap" LineHeight="26"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Stats Dashboard -->
                        <Border Style="{StaticResource GlassPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalScans}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Scans" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding BaymaxChats}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Baymax Chats" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DbItems}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Instruments" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tech Stack Grid -->
                        <TextBlock Text="Powered By" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding TechStack}" ItemTemplate="{StaticResource TechStackTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Engineering Team -->
                        <TextBlock Text="Engineering Team" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,20,0,15"/>
                        <ItemsControl ItemsSource="{Binding TeamMembers}" ItemTemplate="{StaticResource TeamMemberTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="2">

                        <!-- System Health Check -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="System Health" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                <ItemsControl ItemsSource="{Binding SystemHealth}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{Binding IconData}" Fill="#888" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CCC"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Status}" Foreground="#AAA" FontSize="12" Margin="0,0,10,0"/>
                                                    <Ellipse Width="8" Height="8">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#555"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                                        <Setter Property="Fill" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Baymax Neural Link (API Test) -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Baymax Neural Link" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="(Latency Test)" Foreground="#666" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <Button Content="Test Signal" Command="{Binding CheckLatencyCommand}" 
                                        HorizontalAlignment="Right" Background="Transparent" Foreground="#556B2F" BorderThickness="0" Cursor="Hand"/>
                                </Grid>

                                <Grid Margin="0,15,0,0">
                                    <ProgressBar Height="4" Background="#333" Foreground="{Binding LatencyColor}" 
                                             IsIndeterminate="{Binding IsCheckingLatency}" BorderThickness="0"/>
                                </Grid>
                                <TextBlock Text="{Binding LatencyResult}" Foreground="{Binding LatencyColor}" 
                                       HorizontalAlignment="Right" FontSize="12" Margin="0,5,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Changelog Timeline -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="Recent Updates" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                <ItemsControl ItemsSource="{Binding Changelogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Timeline Line -->
                                                <Border Grid.Column="0" BorderBrush="#333" BorderThickness="0,0,1,0" Margin="4,0,15,0">
                                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#555"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMajor}" Value="True">
                                                                        <Setter Property="Fill" Value="#556B2F"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Version}" FontWeight="Bold" Foreground="White"/>
                                                        <TextBlock Text="{Binding Date}" Foreground="#666" FontSize="11" Margin="10,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="#AAA" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Bug Report -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="Report Issue" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding BugReportText, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="60" Background="#222" Foreground="White" BorderThickness="0" Padding="5" TextWrapping="Wrap"
                                     Tag="Describe the anomaly..."/>
                                <Button Command="{Binding SendBugReportCommand}"
                                    Margin="0,10,0,0" HorizontalAlignment="Right" Background="#333" Foreground="White" Padding="15,5" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Transmit"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBugReportSending}" Value="True">
                                                    <Setter Property="Content" Value="Sending..."/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- 3. Footer Signature -->
                <Grid Grid.Row="2" Margin="0,40,0,0" HorizontalAlignment="Center" Opacity="0.5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z" 
                           Fill="#FFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Designed for the Future of Surgery" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>