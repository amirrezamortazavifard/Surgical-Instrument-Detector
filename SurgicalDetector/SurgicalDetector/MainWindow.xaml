<Window x:Class="SurgicalDetector.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewModels="clr-namespace:SurgicalDetector.ViewModels"
xmlns:views="clr-namespace:SurgicalDetector.Views"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance viewModels:ShellViewModel}"
Title="Surgical Detector" Height="800" Width="1300"
WindowStartupLocation="CenterScreen"
Background="{StaticResource BrushPrimaryDark}"
Foreground="{StaticResource BrushTextPrimary}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:ImageDetectionViewModel}">
            <views:ImageDetectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LiveDetectionViewModel}">
            <views:LiveDetectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InstrumentDatabaseViewModel}">
            <views:InstrumentDatabaseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>

        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Wrapper" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Icon" 
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                  Fill="{TemplateBinding Foreground}"
                                  Width="20" Height="20" Stretch="Uniform"/>
                                <TextBlock x:Name="Text" 
                                       Text="{TemplateBinding Content}" 
                                       Margin="15,0,0,0" 
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wrapper" Property="Background" Value="{StaticResource BrushSurfaceLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Wrapper" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Icon" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.4" ShadowDepth="5" Direction="0"/>
            </Border.Effect>

            <Grid x:Name="SidebarGrid">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="260"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggle}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="70" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,30,20,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="MenuToggle" Grid.Column="0" Width="30" Height="30" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" 
                                      Fill="{StaticResource BrushAccent}" Stretch="Uniform"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <TextBlock x:Name="AppTitle" Grid.Column="1" Text="SURGICAL AI" 
                           Foreground="White" FontWeight="Bold" FontSize="18" 
                           VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Row="1">
                    <RadioButton GroupName="Nav" Content="Detection" 
                             Command="{Binding NavigateImageDetectionCommand}"
                             Style="{StaticResource NavRadioButtonStyle}"
                             IsChecked="True"
                             Tag="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M13.96,12.29L11.21,15.83L9.25,13.47L6.5,17H17.5L13.96,12.29Z"/>

                    <RadioButton GroupName="Nav" Content="Live Camera" 
                             Command="{Binding NavigateLiveDetectionCommand}"
                             Style="{StaticResource NavRadioButtonStyle}"
                             Tag="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"/>

                    <RadioButton GroupName="Nav" Content="Baymax Chat" 
                             Command="{Binding NavigateChatCommand}"
                             Style="{StaticResource NavRadioButtonStyle}"
                             Tag="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H6L4,18V4H20"/>

                    <RadioButton GroupName="Nav" Content="Database" 
                             Command="{Binding NavigateInstrumentDatabaseCommand}"
                             Style="{StaticResource NavRadioButtonStyle}"
                             Tag="M12,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H20A2,2 0 0,0 22,19V5A2,2 0 0,0 20,3H12M12,19H4V5H12V19M20,19H14V17H20V19M20,15H14V13H20V15M20,11H14V9H20V11M20,7H14V5H20V7Z"/>

                    <RadioButton GroupName="Nav" Content="Settings" 
                             Command="{Binding NavigateSettingsCommand}"
                             Style="{StaticResource NavRadioButtonStyle}"
                             Tag="M19.14,12.94C19.14,12.78 19.14,12.61 19.14,12.45C19.14,12.29 19.14,12.12 19.14,11.96L21.45,10.15C21.66,9.99 21.71,9.7 21.58,9.46L19.39,5.67C19.26,5.43 18.96,5.33 18.71,5.44L15.99,6.54C15.42,6.11 14.81,5.75 14.16,5.48L13.74,2.59C13.71,2.32 13.48,2.12 13.21,2.12H8.79C8.5,2.12 8.29,2.32 8.25,2.59L7.84,5.48C7.19,5.75 6.58,6.11 6.01,6.54L3.29,5.44C3.04,5.33 2.74,5.43 2.61,5.67L0.42,9.46C0.29,9.7 0.34,9.99 0.55,10.15L2.86,11.96C2.86,12.12 2.86,12.29 2.86,12.45C2.86,12.61 2.86,12.78 2.86,12.94L0.55,14.75C0.34,14.91 0.29,15.2 0.42,15.44L2.61,19.23C2.74,19.47 3.04,19.57 3.29,19.46L6.01,18.36C6.58,18.79 7.19,19.15 7.84,19.42L8.25,22.31C8.29,22.58 8.5,22.78 8.79,22.78H13.21C13.48,22.78 13.71,22.58 13.74,22.31L14.16,19.42C14.81,19.15 15.42,18.79 15.99,18.36L18.71,19.46C18.96,19.57 19.26,19.47 19.39,19.23L21.58,15.44C21.71,15.2 21.66,14.91 21.45,14.75L19.14,12.94M11,12.45A2.45,2.45 0 0,1 13.45,10A2.45,2.45 0 0,1 15.9,12.45A2.45,2.45 0 0,1 13.45,14.9A2.45,2.45 0 0,1 11,12.45Z"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20" Opacity="0.5">
                    <RadioButton GroupName="Nav" Content="About" 
                             Command="{Binding NavigateAboutCommand}"
                             Style="{StaticResource NavRadioButtonStyle}"
                             Tag="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BrushPrimaryDark}">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="30">
                <ContentControl.Resources>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="ContentControl.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="30,50,30,30" To="30" Duration="0:0:0.4" DecelerationRatio="0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>