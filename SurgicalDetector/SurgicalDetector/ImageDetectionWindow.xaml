<Window x:Class="SurgicalDetector.ImageDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SurgicalDetector"
        mc:Ignorable="d"
        Title="Image Detection" Height="740" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Window.Resources>
        <Style TargetType="Button" x:Key="SurgicalButtonStyle">
            <Setter Property="Background" Value="#556B2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                x:Name="SelectImageButton"
                Content="Select Image"
                Style="{StaticResource SurgicalButtonStyle}"
                HorizontalAlignment="Center"
                Click="SelectImageButton_Click"/>

        <Border Grid.Row="1" Margin="10" BorderBrush="#556B2F" BorderThickness="2" CornerRadius="5">
            <Image x:Name="ResultImage" Stretch="Uniform"/>
        </Border>

    </Grid>
</Window>